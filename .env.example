# PostgreSQL. For local development (deploy/docker-compose.dev.yml):
DATABASE_URL=postgresql://outpost:outpost@localhost:5440/outpost
# For deploy/docker-compose.yml, only the password is needed (DATABASE_URL is built for you):
POSTGRES_PASSWORD=change-me

# Better Auth
BETTER_AUTH_SECRET=change-me-generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000

# Google login (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: ${BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: comma-separated list of email domains allowed to sign in with Google
GOOGLE_ALLOWED_DOMAINS=

# OIDC identity providers Outpost may contact, comma-separated, wildcards allowed.
# Add your internal IdP here (e.g. https://keycloak.internal.company.com).
SSO_TRUSTED_ORIGINS=https://accounts.google.com,https://login.microsoftonline.com,https://*.okta.com,https://*.onelogin.com,https://*.auth0.com

# Hosts or IPs requests sent from the server must never reach, comma-separated.
# Cloud metadata endpoints (169.254.169.254...) are always blocked.
OUTPOST_BLOCKED_HOSTS=

# Key used to encrypt environment secrets at rest. Defaults to BETTER_AUTH_SECRET.
# Changing it makes existing secrets unreadable.
OUTPOST_ENCRYPTION_KEY=

# Secret used to hash SCIM bearer tokens (at least 32 characters). Defaults to a value derived from BETTER_AUTH_SECRET.
SCIM_CREDENTIAL_SECRET=
