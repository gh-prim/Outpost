// Generated by Better Auth (`npx auth generate`), then extended with Outpost relations.
// Regenerating overwrites the relations marked below: merge by hand.

model User {
  id            String       @id
  name          String
  email         String
  emailVerified Boolean      @default(false)
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  sessions      Session[]
  accounts      Account[]
  teammembers   TeamMember[]
  members       Member[]
  invitations   Invitation[]

  ssoproviders           SsoProvider[]
  scimidentitytombstones ScimIdentityTombstone[]
  scimsubject            ScimSubject?
  scimusers              ScimUser[]
  scimprojectiongrants   ScimProjectionGrant[]

  // Outpost relations (not generated by Better Auth)
  workspaceMembers   WorkspaceMember[]
  createdWorkspaces  Workspace[]         @relation("WorkspaceCreator")
  collectionVersions CollectionVersion[]
  auditLogs          AuditLog[]

  @@unique([email])
  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?
  activeTeamId         String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Organization {
  id          String       @id
  name        String
  slug        String
  logo        String?
  createdAt   DateTime
  metadata    String?
  teams       Team[]
  members     Member[]
  invitations Invitation[]

  // Outpost relations (not generated by Better Auth)
  workspaces Workspace[]
  auditLogs  AuditLog[]

  @@unique([slug])
  @@map("organization")
}

model Team {
  id             String       @id
  name           String
  memberCount    Int          @default(0)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime
  updatedAt      DateTime?    @updatedAt
  teammembers    TeamMember[]

  // Outpost relations (not generated by Better Auth)
  workspaceMembers WorkspaceMember[]

  @@index([organizationId])
  @@map("team")
}

model TeamMember {
  id            String    @id
  teamId        String
  team          Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  membershipKey String?
  createdAt     DateTime?

  @@unique([membershipKey])
  @@index([teamId])
  @@index([userId])
  @@map("teamMember")
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime

  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  teamId         String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

model SsoProvider {
  id             String   @id
  issuer         String
  oidcConfig     String?
  samlConfig     String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerId     String
  organizationId String?
  domain         String
  domainVerified Boolean?

  @@unique([providerId])
  @@map("ssoProvider")
}

model Apikey {
  id                  String    @id
  configId            String    @default("default")
  name                String?
  start               String?
  referenceId         String
  prefix              String?
  key                 String
  refillInterval      Int?
  refillAmount        Int?
  lastRefillAt        DateTime?
  enabled             Boolean?  @default(true)
  rateLimitEnabled    Boolean?  @default(true)
  rateLimitTimeWindow Int?      @default(86400000)
  rateLimitMax        Int?      @default(10)
  requestCount        Int?      @default(0)
  remaining           Int?
  lastRequest         DateTime?
  expiresAt           DateTime?
  createdAt           DateTime
  updatedAt           DateTime
  permissions         String?
  metadata            String?

  @@index([configId])
  @@index([referenceId])
  @@index([key])
  @@map("apikey")
}

model ScimManagedConnection {
  id                          String                       @id
  creationRequestId           String
  connectionId                String
  provisioningDomainId        String
  status                      String
  revision                    Int
  createdAt                   DateTime
  createdBy                   String
  decommissionStartedAt       DateTime?
  decommissionStartedBy       String?
  decommissionedAt            DateTime?
  decommissionedBy            String?
  scimmanagedcredentials      ScimManagedCredential[]
  scimmanagedconnectionevents ScimManagedConnectionEvent[]

  @@unique([creationRequestId])
  @@unique([connectionId])
  @@index([provisioningDomainId])
  @@map("scimManagedConnection")
}

model ScimManagedCredential {
  id                    String                @id
  connectionRecordId    String
  scimmanagedconnection ScimManagedConnection @relation(fields: [connectionRecordId], references: [id], onDelete: Cascade)
  credentialId          String
  tokenDigest           String
  hashVersion           String
  activeSlotKey         String
  status                String
  serializedScopes      String
  expiresAt             DateTime
  createdAt             DateTime
  createdBy             String
  lastUsedAt            DateTime?
  revokedAt             DateTime?
  revokedBy             String?
  decommissionedAt      DateTime?

  @@unique([credentialId])
  @@unique([activeSlotKey])
  @@index([connectionRecordId])
  @@map("scimManagedCredential")
}

model ScimManagedConnectionEvent {
  id                    String                @id
  connectionRecordId    String
  scimmanagedconnection ScimManagedConnection @relation(fields: [connectionRecordId], references: [id], onDelete: Cascade)
  eventKey              String
  sequence              Int
  type                  String
  actorId               String
  credentialId          String?
  createdAt             DateTime

  @@unique([eventKey])
  @@index([connectionRecordId])
  @@map("scimManagedConnectionEvent")
}

model ScimConnectionBinding {
  id                              String    @id
  connectionId                    String
  connectionKey                   String
  provisioningDomainId            String
  createdAt                       DateTime
  decommissionedAt                DateTime?
  decommissionStatus              String    @default("active")
  decommissionCursorUserId        String?
  decommissionReconciledUserCount Int       @default(0)
  decommissionBatchCount          Int       @default(0)
  decommissionRevision            Int       @default(0)
  decommissionCompletedAt         DateTime?
  decommissionLeaseId             String?
  decommissionLeaseExpiresAt      DateTime?

  @@unique([connectionKey])
  @@index([connectionId])
  @@map("scimConnectionBinding")
}

model ScimIdentityTombstone {
  id                   String   @id
  connectionId         String
  provisioningDomainId String
  externalId           String
  externalIdKey        String
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile              String
  deletedAt            DateTime

  @@unique([externalIdKey])
  @@index([connectionId])
  @@index([provisioningDomainId])
  @@index([userId])
  @@map("scimIdentityTombstone")
}

model ScimSubject {
  id              String   @id
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  profileSourceId String?
  revision        Int
  createdAt       DateTime
  updatedAt       DateTime

  @@unique([userId])
  @@index([profileSourceId])
  @@map("scimSubject")
}

model ScimUser {
  id                   String                @id
  connectionId         String
  provisioningDomainId String
  userId               String
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  connectionUserKey    String
  userName             String
  userNameKey          String
  primaryEmail         String
  workEmailValueIndex  String
  emailValueIndex      String
  displayName          String
  formattedName        String
  givenName            String?
  familyName           String?
  serializedEmails     String
  serializedAttributes String?
  externalId           String?
  externalIdKey        String?
  active               Boolean
  orderKey             String
  createdAt            DateTime
  updatedAt            DateTime
  scimprojectiongrants ScimProjectionGrant[]
  scimgroupmembers     ScimGroupMember[]

  @@unique([connectionUserKey])
  @@unique([userNameKey])
  @@unique([externalIdKey])
  @@unique([orderKey])
  @@index([connectionId])
  @@index([provisioningDomainId])
  @@index([userId])
  @@map("scimUser")
}

model ScimProjectionGrant {
  id                   String   @id
  connectionId         String
  provisioningDomainId String
  scimUserId           String
  scimuser             ScimUser @relation(fields: [scimUserId], references: [id], onDelete: Cascade)
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceKind           String
  sourceId             String
  sourceValue          String?
  role                 String
  grantKey             String
  createdAt            DateTime
  updatedAt            DateTime

  @@unique([grantKey])
  @@index([connectionId])
  @@index([provisioningDomainId])
  @@index([scimUserId])
  @@index([userId])
  @@map("scimProjectionGrant")
}

model ScimGroup {
  id                   String            @id
  connectionId         String
  provisioningDomainId String
  revision             Int               @default(0)
  displayName          String
  displayNameKey       String
  externalId           String?
  externalIdKey        String?
  orderKey             String
  createdAt            DateTime
  updatedAt            DateTime
  scimgroupmembers     ScimGroupMember[]

  @@unique([displayNameKey])
  @@unique([externalIdKey])
  @@unique([orderKey])
  @@index([connectionId])
  @@index([provisioningDomainId])
  @@map("scimGroup")
}

model ScimGroupMember {
  id            String    @id
  connectionId  String
  groupId       String
  scimgroup     ScimGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  scimUserId    String
  scimuser      ScimUser  @relation(fields: [scimUserId], references: [id], onDelete: Cascade)
  membershipKey String
  createdAt     DateTime

  @@unique([membershipKey])
  @@index([connectionId])
  @@index([groupId])
  @@index([scimUserId])
  @@map("scimGroupMember")
}
